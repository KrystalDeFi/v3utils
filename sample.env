# Verifier config for `make verify-*`. VERIFIER defaults to etherscan; set to blockscout
# for chains Etherscan doesn't support (e.g. Robinhood: VERIFIER=blockscout,
# VERIFIER_URL=https://robinhoodchain.blockscout.com/api/). VERIFIER_API_KEY is the
# unified key for either verifier (falls back to ETHERSCAN_API_KEY if unset).
VERIFIER=etherscan
VERIFIER_URL=https://api.etherscan.io/v2/api?chainid=8453
VERIFIER_API_KEY=
NFPMS=0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1,0x46A15B0b27311cedF172AB29E4f4766fbE7F4364,0x80C7DD17B01855a6D2347444a0FCC36136a314de,0x827922686190790b37229fd06084350E74485b72
# WETH is the token representing native value on this chain, and NATIVE_MODE says how the two relate:
#   NATIVE_MODE=0 (default) WRAPPED   - WETH is a WETH9 wrapper, wrapped/unwrapped 1:1 via deposit/withdraw.
#   NATIVE_MODE=1           ENSHRINED - WETH is an ERC20 *view* of the native asset sharing one balance
#                                       with it, with no wrapper to call (Arc: USDC at 0x3600...).
# NATIVE_SCALE is units of native per 1 smallest unit of WETH. Always 1 when WRAPPED; on Arc it is
# 1e12, because the ERC20 view has 6 decimals against 18-decimal native.
# Chains with a normal wrapper can omit both - they default to WRAPPED/1. Under NATIVE_MODE=1 the
# default is withdrawn: NATIVE_SCALE must be set explicitly, and initialize additionally checks it
# against the token's own decimals(), because a wrong scale silently underpays every native transfer
# and initialize is one-shot with no setter.
WETH=0x4200000000000000000000000000000000000006
NATIVE_MODE=0
NATIVE_SCALE=1
MULTISIG=0x9A99252A76f7B40Cbf2002a8dB2977C85fA306DF

# Shared env values
PRIVATE_KEY=
WITHDRAWER=0xB40596162Ab7EC3b6EF0F99d8ECC8e9c7bef2a08
FEE_TAKER=0x8c4f68b691bdc29dece2c4e569a6cff3f042676f
SALT_SEED=th1s_1s_a_v3ry_s3cur3_s4lt
STRUCT_HASH_ADDRESS=0xB486F83280F19cf652843b8F79e52572D589Bbf9
NFPM_LIB_ADDRESS=0x5306493CCF612bc8564B30B0CDB7ff8fbd719a95
