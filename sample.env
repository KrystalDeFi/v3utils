CHAIN_ID=8453
RPC_URL=
GAS_PRICE=10000000
KRYSTAL_ROUTER=0x6fD481970744F9Bc0044a81859FD92431a2Dd67D
# Verifier config for `make verify-*`. VERIFIER defaults to etherscan; set to blockscout
# for chains Etherscan doesn't support (e.g. Robinhood: VERIFIER=blockscout,
# VERIFIER_URL=https://robinhoodchain.blockscout.com/api/). VERIFIER_API_KEY is the
# unified key for either verifier (falls back to ETHERSCAN_API_KEY if unset).
VERIFIER=etherscan
VERIFIER_URL=https://api.etherscan.io/v2/api?chainid=8453
VERIFIER_API_KEY=
NFPMS=0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1,0x46A15B0b27311cedF172AB29E4f4766fbE7F4364,0x80C7DD17B01855a6D2347444a0FCC36136a314de,0x827922686190790b37229fd06084350E74485b72
# WETH is the token representing native value on this chain, and NATIVE_MODE says how the two relate:
#   NATIVE_MODE=0 (default) WRAPPED   - WETH is a WETH9 wrapper, wrapped/unwrapped 1:1 via deposit/withdraw.
#   NATIVE_MODE=1           ENSHRINED - WETH is an ERC20 *view* of the native asset sharing one balance
#                                       with it, with no wrapper to call (Arc: USDC at 0x3600...).
# There is no scale to configure: initialize derives it from IERC20Metadata(WETH).decimals(), so a
# wrong value is unrepresentable rather than merely rejected. Chains with a normal wrapper can omit
# NATIVE_MODE entirely - it defaults to WRAPPED.
WETH=0x4200000000000000000000000000000000000006
NATIVE_MODE=0
MULTISIG=0x9A99252A76f7B40Cbf2002a8dB2977C85fA306DF

# Shared env values
PRIVATE_KEY=
WITHDRAWER=0xB40596162Ab7EC3b6EF0F99d8ECC8e9c7bef2a08
FEE_TAKER=0x8c4f68b691bdc29dece2c4e569a6cff3f042676f
SALT_SEED=th1s_1s_a_v3ry_s3cur3_s4lt
# The CREATE2-deployed library addresses are NOT configured here. foundry.toml's `libraries` is the
# single source of truth: the deploy links against it and `make verify-*` derives its --libraries
# flags from it. `script/check-libs.sh` (a prerequisite of the deploy and verify targets) asserts
# each pinned address holds the bytecode we build, on the chain RPC_URL points at.

# V3UtilsRouter (`make dryrun-v3router`, `make deploy-v3router`, `make verify-v3router`; see the Makefile).
# Also uses the shared PRIVATE_KEY, RPC_URL, CHAIN_ID, WITHDRAWER and FEE_TAKER above. NATIVE_WETH / NATIVE_MODE are
# the router's own names for the WETH / NATIVE_MODE keys above (NATIVE_MODE=1 requires NATIVE_WETH to have code: Arc's
# USDC view at 0x3600...). The deployer needs no role: the script hands DEFAULT_ADMIN_ROLE + ADMIN_ROLE to ADMIN and
# renounces its own. ADMIN has custody-level power over every approving user's positions until `lock()`: use a
# timelock in front of the Safe. The script never locks; call `lock()` after checking the deployment.
# ADAPTERS is `nfpm:kind` pairs; kind is uni, algebrav1, aerodrome, ramses or integral. The Aero farm goes on every
# `aerodrome` entry when AERO_GAUGE_FACTORY / AERO_REWARD_TOKEN are set (Base: new AERO + compound true; elsewhere the
# leaf voter's RECEIPT_TOKEN + compound false).
# ADMIN=
# OPERATOR=
# SWAP_ROUTER=
# NATIVE_WETH=0x4200000000000000000000000000000000000006
# ADAPTERS=0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1:uni,0x4857DB576eE0e45F10525eC59527BfD10beeC60b:aerodrome
# AERO_GAUGE_FACTORY=0xf437f62053ACB121665b8fDBfeA8F214FB8E589d
# AERO_REWARD_TOKEN=0x3f5bF3EdAc59d650D8fDf9657a71F2f904A3a4Ee
# AERO_COMPOUND_ENABLED=true
# Optional: the verify target reads the deployed addresses from the broadcast; set to verify another deploy.
# V3ROUTER_DEPLOYED=V3UtilsRouter:0x...,CoreMint:0x...
